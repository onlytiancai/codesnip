# .env.example — 复制为 .env 后再填真实值 (cp .env.example .env)
# .env 默认被 .gitignore 忽略，避免泄漏 MINIMAX_API_KEY

# 必填 — 从 https://platform.MiniMax.io/user-center/basic-information/interface-key 取
MINIMAX_API_KEY=

# 音色 ID
# 中文（zh + explain 共用）
ZH_VOICE_ID=Chinese_patitent_teacher
# 英文（en）
EN_VOICE_ID=English_PassionateWarrior

# 可选 — 端口 / 模型 / 速度 / 情感
# PORT=3000
# MINIMAX_TTS_MODEL=speech-02-hd
# MINIMAX_TTS_ENDPOINT=https://api.minimaxi.com/v1/t2a_v2
# TTS_SPEED=1.0
# ZH_TTS_EMOTION=calm
# EN_TTS_EMOTION=fluent
# EXPLAIN_TTS_EMOTION=calm

# 可选 — 数据文件相对路径（默认指向 ../ 父目录）
# DATA_GROUPS=../cet4_hexinci_groups_v3.json
# DATA_DICT=../CET4luan_1.json
