# ===== server/.env =====
# 复制成 .env 后按需修改。.env 不进 git（见 .gitignore）。
# 代码启动时会自动加载它（src/config/env.ts）。

# Web 服务端口
PORT=8787

# Ollama API 地址（本地默认即可）
OLLAMA_HOST=http://127.0.0.1:11434

# 改写/同义词替换用的模型
OLLAMA_MODEL=s2021008840/hy-mt2:1.8b

# 候选词数量上限（向下兼容，即模型返回多于此值也会被截断）
MAX_CANDIDATES=5

# ===== API Key =====
# key 写在这里，设置页只填「环境变量名」指向下面某个变量。
# 变量名和 provider 的 id 对应：id 大写 + '-' 换成 '_' + '_KEY'。
MINIMAX_ANTHROPIC_KEY=
MINIMAX_OPENAI_KEY=

# ===== 查词 =====
# 词库 JSON（JSONL，一行一个词条）的路径。
# 指向 024-cet4 那个项目的 vocab_all.json。
VOCAB_PATH=/Users/huhao/src/codesnip/python/ai/024-cet4/vocab_all.json

# ===== 数据库 =====
# SQLite 库文件：配置 + 用户 + 会话 + token 用量都在这里。
# 不填就用默认的 server/data/app.db（相对路径不行，要写绝对路径）。
# 首次启动会自动把老的 server/data/config.json 导入进来（导入后不再回写 JSON）。
# DB_PATH=/Users/huhao/src/codesnip/python/ai/035-tiptap-demo/server/data/app.db

# ===== 登录 =====
# 第一次启动（库里还没有任何用户）时自动播种一个账号。
# 用户名 / 密码改这两行；改完要清掉库里的 users 表才会重新播种。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 来自 127.0.0.1、且不带 Origin / Sec-Fetch-Site 的请求（curl、CLI 等本地工具）
# 视为本地调用，免登录放行（但不计进任何人的 token 用量）。
# 设成 0 就完全关掉这个放行 —— 所有请求都必须登录。
AUTH_LOCAL_BYPASS=1

# ===== 调试日志 =====
# 设成 1 就打开调试日志：server 端打启动 / 鉴权 / LLM 调用 / token 落库 / 配置变更，
# 浏览器 console 也同步打开（前端通过 GET /api/debug 拿这个开关）。
DEBUG=1
